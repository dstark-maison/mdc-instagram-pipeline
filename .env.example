# Copy to .env.local for local dev only — never commit real values.
# In production (GitHub Actions) these are injected from repo secrets.
# Local runs need an env loader (e.g. `python -m dotenv run -- python ig_draft.py`
# with python-dotenv installed) since the scripts read os.environ directly.

